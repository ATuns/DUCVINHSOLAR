rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCategory(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'label' in data && data.label is string && data.label.size() >= 1 && data.label.size() <= 500;
    }

    function isValidBrand(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'name' in data && data.name is string && data.name.size() >= 1 && data.name.size() <= 500 &&
             'categoryId' in data && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 256;
    }

    function isValidProduct(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'name' in data && data.name is string && data.name.size() >= 1 && data.name.size() <= 500 &&
             'category' in data && data.category is string && data.category.size() >= 1 && data.category.size() <= 256;
    }

    function isValidProject(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'title' in data && data.title is string && data.title.size() >= 1 && data.title.size() <= 500;
    }

    function isValidBlogPost(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'title' in data && data.title is string && data.title.size() >= 1 && data.title.size() <= 500;
    }

    function isValidInquiry(data) {
      return data is map &&
             'id' in data && data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
             'customerName' in data && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 500 &&
             'phone' in data && data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 100;
    }

    // Connection health check path
    match /test/{docId} {
      allow get, list: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Brands collection
    match /brands/{brandId} {
      allow get, list: if true;
      allow create, update: if isValidId(brandId) && isValidBrand(incoming());
      allow delete: if isValidId(brandId);
    }

    // Products collection
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update: if isValidId(projectId) && isValidProject(incoming());
      allow delete: if isValidId(projectId);
    }

    // BlogPosts collection
    match /blogPosts/{blogId} {
      allow get, list: if true;
      allow create, update: if isValidId(blogId) && isValidBlogPost(incoming());
      allow delete: if isValidId(blogId);
    }

    // Settings collection (companyInfo & seedMeta)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && incoming() is map;
      allow delete: if isValidId(settingId);
    }

    // Customer Inquiries collection
    match /inquiries/{inquiryId} {
      allow get, list: if true;
      allow create, update: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow delete: if isValidId(inquiryId);
    }
  }
}
