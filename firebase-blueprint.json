{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Solar equipment category (e.g. Solar Panels, Inverters, Battery Storage, Solar Lights)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 200 },
        "shortLabel": { "type": "string", "maxLength": 200 },
        "desc": { "type": "string", "maxLength": 500 },
        "iconName": { "type": "string", "maxLength": 64 },
        "order": { "type": "number" }
      },
      "required": ["id", "label"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Manufacturer brand within a specific equipment category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "origin": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "categoryId"]
    },
    "Product": {
      "title": "Product",
      "description": "Solar energy product with technical specifications, inventory stock, and multi-image gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 200 },
        "shortDesc": { "type": "string", "maxLength": 1000 },
        "fullDesc": { "type": "string", "maxLength": 5000 },
        "stock": { "type": "number" },
        "unit": { "type": "string", "maxLength": 64 },
        "featured": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "svgType": { "type": "string", "maxLength": 64 },
        "specs": { "type": "array" },
        "highlights": { "type": "array" },
        "applications": { "type": "array" },
        "warrantyYears": { "type": "number" },
        "origin": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "sku", "name", "category", "brand"]
    },
    "Project": {
      "title": "Project",
      "description": "Featured solar installation project with multi-photo gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "location": { "type": "string", "maxLength": 200 },
        "capacity": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 64 },
        "completionDate": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "keyEquipment": { "type": "array" },
        "estimatedSaving": { "type": "string", "maxLength": 200 },
        "svgType": { "type": "string", "maxLength": 64 },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" }
      },
      "required": ["id", "title", "category"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global company information and seed metadata",
      "type": "object",
      "properties": {
        "legalName": { "type": "string", "maxLength": 300 },
        "tradeName": { "type": "string", "maxLength": 200 },
        "taxCode": { "type": "string", "maxLength": 64 },
        "taxAddress": { "type": "string", "maxLength": 500 },
        "officeAddress": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 100 },
        "representative": { "type": "string", "maxLength": 200 },
        "affiliatedUnits": { "type": "array" },
        "hotlineZalo": { "type": "string", "maxLength": 64 },
        "warehousePhone": { "type": "string", "maxLength": 64 },
        "secretaryPhone": { "type": "string", "maxLength": 64 },
        "warehouseAddress": { "type": "string", "maxLength": 500 },
        "warehouseMapUrl": { "type": "string", "maxLength": 1500 },
        "email": { "type": "string", "maxLength": 200 },
        "workingHours": { "type": "string", "maxLength": 200 },
        "seeded": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      }
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer quote and consultation inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "address": { "type": "string", "maxLength": 500 },
        "productInterest": { "type": "string", "maxLength": 300 },
        "note": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerName", "phone", "status"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Solar energy blog article and technical guide synced across all devices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "maxLength": 150 },
        "author": { "type": "string", "maxLength": 150 },
        "publishedAt": { "type": "string", "maxLength": 100 },
        "readTime": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 1500 },
        "content": { "type": "string", "maxLength": 20000 },
        "tags": { "type": "array" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "category"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories synced across all devices"
    },
    "/brands/{brandId}": {
      "schema": "Brand",
      "description": "Product brands synced across all devices"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products, specs, images, and inventory stock synced across all devices"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Featured projects and photo albums synced across all devices"
    },
    "/blogPosts/{blogId}": {
      "schema": "BlogPost",
      "description": "Blog articles and solar energy guides synced across all devices"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Company legal profile and database seed state"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Customer inquiries and quote requests"
    }
  }
}
