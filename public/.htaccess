<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Tự động chuyển sang HTTPS (Let's Encrypt Free SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Chuyển toàn bộ các lời gọi /api/... vào file api.php kết nối MySQL/Database nội bộ trên Linux Hosting
  RewriteRule ^api/(.*)$ /api.php?route=$1 [QSA,L]

  # Giữ nguyên các file và thư mục có thật (assets, hình ảnh, api.php...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Điều hướng mọi đường dẫn giao diện về index.html cho React SPA
  RewriteRule . /index.html [L]
</IfModule>

# Bảo vệ file cấu hình và thư mục dữ liệu nội bộ trên Hosting
<FilesMatch "^(\.env\.mysql\.php|ducvinhsolar\.sqlite|ducvinhsolar_db\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Bật nén Gzip giúp web tải siêu tốc trên Linux Hosting NVMe
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
